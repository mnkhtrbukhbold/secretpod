{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	header X-Content-Type-Options nosniff

	handle /healthz {
		header Cache-Control "no-store"
		respond "ok" 200
	}

	@uncached path /flutter_service_worker.js /version.json
	handle @uncached {
		header Cache-Control "no-store"
		file_server
	}

	# Filenames are stable: browsers revalidate; Railway caches for one hour.
	# Configure Railway's CDN to purge ALL files after successful deployments.
	@runtime path /flutter.js /flutter_bootstrap.js /main.dart.js /manifest.json
	handle @runtime {
		header Cache-Control "public, max-age=0, s-maxage=3600, must-revalidate"
		file_server
	}

	@assets path /assets/* /canvaskit/* /icons/* /favicon.png /secretpod.svg
	handle @assets {
		header Cache-Control "public, max-age=0, s-maxage=3600, must-revalidate"
		file_server
	}

	handle {
		# Deep links use the same short edge lifetime as the app shell.
		route {
			try_files {path} /index.html
			header Cache-Control "public, max-age=0, s-maxage=60, must-revalidate"
			file_server
		}
	}
}
