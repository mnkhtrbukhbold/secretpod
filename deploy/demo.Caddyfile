{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	header X-Content-Type-Options nosniff

	handle /healthz {
		header Cache-Control "no-store"
		respond "ok" 200
	}

	# Flutter's executable filenames are stable across releases.
	@runtime path /index.html /flutter.js /flutter_bootstrap.js /main.dart.js /flutter_service_worker.js /version.json /manifest.json
	handle @runtime {
		header Cache-Control "no-store"
		file_server
	}

	@assets path /assets/* /canvaskit/* /icons/* /favicon.png /secretpod.svg
	handle @assets {
		header Cache-Control "public, max-age=3600, must-revalidate"
		file_server
	}

	handle {
		# Apply headers after the rewrite so deep links cannot cache index.html.
		route {
			try_files {path} /index.html
			header Cache-Control "no-store"
			file_server
		}
	}
}
