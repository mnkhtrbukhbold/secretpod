# Allowlisted source-only build context; never include generated local assets.
**
!Dockerfile
!secretpod/
secretpod/**
!secretpod/pubspec.yaml
!secretpod/pubspec.lock
!secretpod/secretpod_flutter/
secretpod/secretpod_flutter/**
!secretpod/secretpod_flutter/pubspec.yaml
!secretpod/secretpod_flutter/lib/
!secretpod/secretpod_flutter/lib/**
!secretpod/secretpod_flutter/assets/
!secretpod/secretpod_flutter/assets/**
!secretpod/secretpod_flutter/web/
!secretpod/secretpod_flutter/web/**
!secretpod/secretpod_client/
secretpod/secretpod_client/**
!secretpod/secretpod_client/pubspec.yaml
!secretpod/secretpod_client/lib/
!secretpod/secretpod_client/lib/**
!secretpod/secretpod_server/
secretpod/secretpod_server/**
!secretpod/secretpod_server/pubspec.yaml
!secretpod/secretpod_server/bin/
!secretpod/secretpod_server/bin/**
!secretpod/secretpod_server/lib/
!secretpod/secretpod_server/lib/**
!secretpod/secretpod_server/config/
secretpod/secretpod_server/config/**
!secretpod/secretpod_server/config/development.yaml
!secretpod/secretpod_server/config/staging.yaml
!secretpod/secretpod_server/config/production.yaml
!secretpod/secretpod_server/config/test.yaml
!secretpod/secretpod_server/config/generator.yaml
!secretpod/secretpod_server/web/
!secretpod/secretpod_server/web/**
secretpod/secretpod_server/web/app/**

# Keep credentials and runtime artifacts out even inside allowed directories.
**/.git
**/.cache
**/.dart_tool
**/build
**/data
**/backups
**/backup
**/.env
**/.env.*
**/*.env
**/*.env.*
**/passwords.yaml*
**/passwords.*.yaml
**/credentials.json
**/*service_account*.json
**/*service-account*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa*
**/id_ed25519*
**/*.sqlite*
**/*.db
**/*.db-*
**/*.db.*
**/vault.json*
**/vault.lock
**/*.log
**/*.bak
**/*.backup
**/*.dump
**/.aws
**/.ssh
**/.gnupg
**/.codex
**/.agents
**/.claude
**/.gemini
**/.cursor
**/.idea
**/.vscode
**/.mcp.json
**/.scloud
**/.serverpod
**/.DS_Store
**/Thumbs.db
